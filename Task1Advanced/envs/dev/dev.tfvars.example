# Development environment — minimal resources, cost-saving CPU fraction
# Copy this file to dev.tfvars and fill in your values
folder_id          = "REPLACE_WITH_YOUR_FOLDER_ID"
zone               = "ru-central1-a"
subnet_id          = "REPLACE_WITH_YOUR_SUBNET_ID"
ssh_public_key     = "REPLACE_WITH_YOUR_SSH_PUBLIC_KEY"

vm_name            = "future20-dev"
cores              = 2
memory             = 4
core_fraction      = 20
boot_disk_image_id = "fd8vmcue7aajpmeo39kk" # Ubuntu 22.04 LTS
boot_disk_size     = 20
disk_size          = 20
disk_type          = "network-hdd"
vm_user            = "ubuntu"
nat                = false

labels = {
  env     = "dev"
  project = "future20"
  team    = "platform"
}
