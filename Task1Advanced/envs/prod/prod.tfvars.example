# Production environment — full resources, SSD, public IP, guaranteed CPU
# Copy this file to prod.tfvars and fill in your values
folder_id          = "REPLACE_WITH_YOUR_FOLDER_ID"
zone               = "ru-central1-a"
subnet_id          = "REPLACE_WITH_YOUR_SUBNET_ID"
ssh_public_key     = "REPLACE_WITH_YOUR_SSH_PUBLIC_KEY"

vm_name            = "future20-prod"
cores              = 4
memory             = 16
core_fraction      = 100
boot_disk_image_id = "fd8vmcue7aajpmeo39kk" # Ubuntu 22.04 LTS
boot_disk_size     = 50
disk_size          = 100
disk_type          = "network-ssd"
vm_user            = "ubuntu"
nat                = true

labels = {
  env     = "prod"
  project = "future20"
  team    = "platform"
}
